+async def verify_one(song_dir: Path, brief: str) -> dict:
+    """evolve/check.py on one song, compact; an exception or a timeout is a failure line, never a crash."""
+    def run():
+        import sys
+        evolve = Path(__file__).resolve().parents[1] / "evolve"
+        if str(evolve) not in sys.path:
+            sys.path.insert(0, str(evolve))
+        from check import check
+        from contract import contract
+        return check(song_dir, contract(brief))
+    try:
+        r = await asyncio.wait_for(asyncio.to_thread(run), VERIFY_TIMEOUT)
+    except asyncio.TimeoutError:
+        return {"pass": False, "why": [f"check timed out after {VERIFY_TIMEOUT} s"]}
+    except Exception as e:                                       # noqa: BLE001
+        log.exception("verify_songs")
+        return {"pass": False, "why": [f"check failed: {type(e).__name__}: {str(e)[:120]}"]}
+    m = r.get("measured") or {}
+    return {"pass": bool(r.get("pass")), "tempo": r.get("tempo"), "key": r.get("key"), "clean": r.get("clean"),
+            "delivered": r.get("delivered"), "why": r.get("why") or [],
+            "measured": {"bpm": m.get("bpm"), "key": m.get("key")}, "contract": r.get("contract")}
+
